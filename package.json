    "@vitest/coverage-v8": "^5.0.0",
    "autocannon": "^8.0.0",
    "date-fns": "^4.4.0",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "rumdl": "^0.2.67",
