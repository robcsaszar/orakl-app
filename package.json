    "@sentry/sveltekit": "^10.73.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@svgrid/grid": "^3.0.3",
    "effect": "^3.22.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
